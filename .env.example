# Shadow Edge Marketing Ops example environment
# Copy to .env and fill only when ready. Keep live gates disabled until docs/activation-checklist.md passes.

ANTHROPIC_API_KEY=
YOUTUBE_CLIENT_SECRETS_FILE=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
STOCKTWITS_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
EMAIL_PROVIDER_API_KEY=
PUBLIC_LEAD_API_TOKEN=

# Safety defaults; do not set true until final activation review.
LIVE_PUBLISH_ENABLED=false
LIVE_EMAIL_ENABLED=false

# Local console port. Shadow Edge defaults to 8876 to avoid the futures-bot
# operator server commonly running on 8765.
CONSOLE_PORT=8876
